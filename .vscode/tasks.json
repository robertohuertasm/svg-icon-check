{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean: output directory",
      "command": "rm",
      "args": ["-rf", "output/"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "build: debug",
      "command": "cargo",
      "args": ["build"],
      "problemMatcher": ["$rustc"],
      "dependsOn": ["clean: output directory"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "close": true
      }
    }
  ]
}
